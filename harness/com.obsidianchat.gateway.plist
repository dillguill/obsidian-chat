<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd install for the ACP bridge (specs/001-acp-mcp-migration). After editing paths below:
     launchctl load ~/Library/LaunchAgents/com.obsidianchat.gateway.plist
     launchctl unload ... to stop. KeepAlive restarts it; ThrottleInterval avoids crash loops.
     Run mcp-rules-proxy.mjs as its own separate launchd job (or process) before this one starts,
     since the bridge's spawned harness expects it to already be listening. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.obsidianchat.gateway</string>

  <key>ProgramArguments</key>
  <array>
    <!-- replace with `which node` output (launchd has no PATH from your shell) -->
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/you/projects/obsidian-chat/harness/src/acp-bridge.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/you/projects/obsidian-chat/harness</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/obsidian-chat-gateway.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/obsidian-chat-gateway.err.log</string>
</dict>
</plist>
